# StoryBurrow configuration

# Host GPU render group
# Find with: stat -c '%g' /dev/dri/renderD128
RENDER_GID=109

# LAN IP address or hostname used to access StoryBurrow
# Replace with your server's actual address.
STORYBURROW_HOST=192.168.1.100

# External HTTPS port
STORYBURROW_PORT=2500

# Directory for StoryBurrow data (e.g., data, logs, games, saves, etc.)
STORYBURROW_DATA_DIR=/configs/storyburrow

# Virtual display resolution
RESOLUTIONW=1920
RESOLUTIONH=1080

# Container timezone
TZ=America/Chicago
