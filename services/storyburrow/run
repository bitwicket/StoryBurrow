#!/bin/bash
set -e

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
ENV_FILE="$XDG_RUNTIME_DIR/container-env"

# Wait until Selkies has initialized the session.
while [ ! -f "$ENV_FILE" ]; do
    sleep 0.2
done

# Inherit Selkies' display, audio, and GPU settings.
set -a
source "$ENV_FILE"
set +a

cd /app
exec /opt/storyburrow-venv/bin/python -u /app/game_manager.py
